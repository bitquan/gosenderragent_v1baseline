{
  "name": "gosenderr-vscode-companion",
  "publisher": "gosenderr",
  "displayName": "GoSenderr VS Code Companion",
  "description": "Chat-first companion for the GoSenderr desktop agent runtime.",
  "version": "0.1.3",
  "engines": {
    "vscode": "^1.95.0"
  },
  "scripts": {
    "check": "node --check extension.js"
  },
  "main": "./extension.js",
  "files": [
    "extension.js",
    "src",
    "resources",
    "README.md",
    "integration.json",
    "package.json"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gosenderrSidebar",
          "title": "GoSenderr",
          "icon": "resources/activitybar-icon.svg"
        }
      ]
    },
    "views": {
      "gosenderrSidebar": [
        {
          "type": "webview",
          "id": "gosenderr.workbenchView",
          "name": "CHAT"
        }
      ]
    },
    "commands": [
      {
        "command": "gosenderr.openDesktopAgent",
        "title": "GoSenderr: Open Companion"
      },
      {
        "command": "gosenderr.openWorkbench",
        "title": "GoSenderr: Open Chat"
      },
      {
        "command": "gosenderr.openWorkbenchPanel",
        "title": "GoSenderr: Open Chat Panel"
      },
      {
        "command": "gosenderr.submitTask",
        "title": "GoSenderr: Send Task"
      },
      {
        "command": "gosenderr.continueTask",
        "title": "GoSenderr: Continue Last Task"
      },
      {
        "command": "gosenderr.repairLoop",
        "title": "GoSenderr: Repair Loop"
      },
      {
        "command": "gosenderr.selfImprove",
        "title": "GoSenderr: Run Background Self-Improve Pass"
      },
      {
        "command": "gosenderr.autopilot",
        "title": "GoSenderr: Run Background Autopilot Pass"
      },
      {
        "command": "gosenderr.reviewApprove",
        "title": "GoSenderr: Approve Review File"
      },
      {
        "command": "gosenderr.reviewReject",
        "title": "GoSenderr: Reject Review File"
      },
      {
        "command": "gosenderr.retryWithResearch",
        "title": "GoSenderr: Retry With Research"
      },
      {
        "command": "gosenderr.runNextAction",
        "title": "GoSenderr: Run Next Safe Action"
      },
      {
        "command": "gosenderr.queueNextTask",
        "title": "GoSenderr: Queue Next Bounded Task"
      },
      {
        "command": "gosenderr.openTrace",
        "title": "GoSenderr: Open Latest Trace"
      },
      {
        "command": "gosenderr.openFiles",
        "title": "GoSenderr: Open Touched Files"
      },
      {
        "command": "gosenderr.openTaskHub",
        "title": "GoSenderr: Open Task Hub"
      },
      {
        "command": "gosenderr.openProblems",
        "title": "GoSenderr: Open Problems"
      },
      {
        "command": "gosenderr.openSandbox",
        "title": "GoSenderr: Open Sandbox Artifact"
      },
      {
        "command": "gosenderr.openProviderSettings",
        "title": "GoSenderr: Open Provider Settings"
      },
      {
        "command": "gosenderr.openSourceControl",
        "title": "GoSenderr: Open Source Control"
      },
      {
        "command": "gosenderr.openGitHistory",
        "title": "GoSenderr: Open Git History"
      }
    ]
  }
}