# Windows PC tuning template for GoSenderr Desktop Agent PC
# Keep active runtime, models, and caches on the fast SSD.
# assistant_artifacts_root: E:/dev/projects/gosenderr_dev_offload
# assistant_training_model_storage_root: E:/dev/projects/gosenderr_dev_offload/local_model_storage/models
# Keep rollback archives, releases, and migration backups on the backup drive.
# assistant_cold_storage_root: D:/dev/projects/gosenderr_dev_backup
# assistant_promotions_root: D:/dev/projects/gosenderr_dev_backup/assistant_promotions
# assistant_desktop_release_dir: D:/dev/projects/gosenderr_dev_backup/desktop_releases
# assistant_migrated_internal_root: D:/dev/projects/gosenderr_dev_backup/migrated_internal
assistant_training_hardware_target: windows-i9-32gb-rtx4060-8gb
assistant_training_profile: high
assistant_training_eco_mode: false
assistant_training_cpu_limit_percent: 70
assistant_training_thread_limit: 8
assistant_training_thermal_preset: 85
assistant_training_live_sampling_sec: 3
assistant_training_ollama_model: qwen2.5-coder:7b
assistant_engine_model_base_model: qwen2.5-coder:7b
assistant_engine_model_base_provider: ollama
assistant_engine_model_provider_source: ollama
assistant_task_mode_planner_provider: ollama
assistant_task_mode_planner_model: qwen2.5-coder:7b
assistant_task_mode_coder_provider: ollama
assistant_task_mode_coder_model: qwen2.5-coder:14b
assistant_task_mode_validator_provider: ollama
assistant_task_mode_validator_model: qwen2.5-coder:7b
assistant_task_mode_summarizer_provider: ollama
assistant_task_mode_summarizer_model: qwen2.5-coder:7b
